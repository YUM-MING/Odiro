# ===== Odiro 환경변수 =====
# 이 파일을 복사해서 .env 로 저장하고 값을 채우세요. (.env 는 git 에 올라가지 않음)

# --- LLM (둘 중 하나 이상) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# 기본 사용 모델. provider 는 openai | anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- 장소 검색 / 지도 ---
# https://developers.kakao.com  > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=
# 같은 페이지의 JavaScript 키 (인트로 지도 애니메이션용)
KAKAO_JS_API_KEY=

# --- 길찾기 ---
# 자차: https://developers.kakaomobility.com  (카카오모빌리티 길찾기, KakaoAK 키 별도 발급)
KAKAO_MOBILITY_API_KEY=
# 뚜벅이(보행자): https://openapi.sk.com  (TMAP API appKey)
TMAP_APP_KEY=

# --- 대량 장소 데이터 (한국관광공사 TourAPI 4.0) ---
# https://www.data.go.kr  > "한국관광공사_국문 관광정보 서비스_GW" 활용신청 > 일반 인증키(Decoding)
# ※ 전국 수집하려면 활용신청 후 "운영계정 트래픽 증량" 신청 필요 (개발계정은 일 1,000건)
TOUR_API_KEY=
# (선택) 추가 TourAPI Decoding 키. 쉼표로 구분, 따옴표·공백 없이. 상세 수집에서 위 키의 일일 한도가 차면 순서대로 이어 쓴다
TOUR_API_KEYS_EXTRA=

# --- 큐레이션 글 수집 (네이버 블로그 검색 API) ---
# 2026-07-31 부터 네이버 클라우드 플랫폼(ncloud.com) > NAVER API HUB > Application 등록(검색 API 체크) > 인증 정보
# Client ID(약 10자) / Client Secret(약 40자). 구 developers.naver.com 키는 쓰지 않는다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 인터넷 검색 ---
# https://tavily.com
TAVILY_API_KEY=

# --- 날씨 ---
# https://openweathermap.org/api (간단) 또는 기상청 단기예보 (data.go.kr)
OPENWEATHER_API_KEY=
KMA_API_KEY=

# --- 앱 설정 ---
CACHE_DIR=./cache
VECTORSTORE_DIR=./data/vectorstore
RAW_DATA_DIR=./data/raw
